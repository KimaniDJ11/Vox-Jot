+// `fmt::from_fn` is newer than the Rust compiler pinned by the Nix package.
+// This wrapper is equivalent and keeps the crate buildable on that toolchain.
+struct DynAttributeDebug<'a>(&'a dyn DynAttributeValue);
+
+impl fmt::Debug for DynAttributeDebug<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.0.fmt_dyn(f)
+    }
+}
+
 struct NamedAttributeValue<T>(T);
 
 impl<T> DynAttributeValue for NamedAttributeValue<T>
@@ -175,7 +185,7 @@ impl fmt::Debug for Attributes {
 
