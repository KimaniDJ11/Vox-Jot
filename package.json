{
  "name": "vox-jot-app",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-dev-wrapper.mjs",
    "build": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true node ./node_modules/typescript/bin/tsc && BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test --no-default-features --features ci-mock-transcription",
    "test:all": "bun run test:unit && bun run test:rust",
    "test:native-ui": "node scripts/smoke-native-ui.mjs",
    "test:installed-app": "node scripts/full-installed-app-test.mjs",
    "audit:frontend": "bun audit",
    "audit:backend": "cd src-tauri && cargo audit && cargo deny check advisories",
    "audit": "bun run audit:frontend && bun run audit:backend",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "mac:dmg-background": "bash scripts/generate-dmg-background.sh",
    "mac:release": "bash scripts/build-notarized-macos-release.sh",
    "release:local-mac": "bun scripts/distribute-macos-release.ts",
    "mac:setup-notary": "bash scripts/setup-macos-notary-credentials.sh",
    "mac:app-store:audit": "bun scripts/audit-app-store-readiness.ts",
    "mac:app-store:build": "bash scripts/build-macos-app-store.sh",
    "mac:app-store:upload": "UPLOAD_APP_STORE_PKG=true bash scripts/build-macos-app-store.sh",
    "mac:update:notarized": "bash scripts/build-and-install-macos-app.sh",
    "mac:update-installed-app:notarized": "bash scripts/build-and-install-macos-app.sh",
    "mac:update": "bash scripts/block-plain-macos-update.sh mac:update",
    "mac:update-installed-app": "bash scripts/block-plain-macos-update.sh mac:update-installed-app",
    "mac:build-install": "bash scripts/block-plain-macos-update.sh mac:build-install",
    "mac:dev-installed-app": "bash scripts/block-plain-macos-update.sh mac:dev-installed-app",
    "mac:open-installed-app": "bash scripts/open-installed-macos-app.sh",
    "mac:open-dev-app": "bash scripts/open-installed-macos-app.sh",
    "mac:restart-app": "bash scripts/restart-dev-app.sh",
    "speech:build-runtime": "bash scripts/build-speech-runtime.sh",
    "speech:upload-runtime": "bash scripts/upload-speech-runtime-asset.sh",
    "ocr:build-runtime": "bash scripts/build-ocr-runtime.sh",
    "ocr:upload-runtime:hf": "bash scripts/upload-ocr-runtime-to-hf.sh",
    "lint": "node ./node_modules/eslint/bin/eslint.js src",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "regression:download": "bun scripts/download-regression-audio.ts",
    "regression:run": "bun scripts/run-audio-regression.ts",
    "regression:compare": "bun scripts/run-regression-compare.ts",
    "regression:diff": "bun scripts/compare-regression-reports.ts",
    "eval:post-process": "bun scripts/eval-post-process.ts",
    "eval:post-process:dry": "bun scripts/eval-post-process.ts --dry-run",
    "eval:test-bank": "bun scripts/run-test-bank-eval.ts",
    "eval:test-bank:live": "bun scripts/run-test-bank-eval.ts --live",
    "eval:test-bank:sanity": "bun scripts/run-test-bank-eval.ts --suite sanity",
    "eval:hard-model-plan": "bun scripts/validate-hard-model-plan.ts",
    "eval:speech-analysis-readiness": ".venv/bin/python scripts/validate_speech_analysis_models.py --output output/speech-analysis-validation.json",
    "eval:speaker-isolation": ".venv/bin/python scripts/run-speaker-isolation-eval.py",
    "eval:file-asr": "bun scripts/run-file-asr-model-eval.ts",
    "eval:tts": ".venv/bin/python scripts/run-tts-model-eval.py",
    "eval:tts:voice-clone": ".venv/bin/python scripts/run-tts-model-eval.py --suite voice_clone",
    "eval:creative-audio": "bun scripts/run-creative-audio-model-eval.ts",
    "eval:screen-ocr": "swift scripts/run-screen-ocr-eval.swift",
    "eval:spelling": "bun scripts/eval-post-process.ts --cases test-data/spelling-corpus/cases.json --exact-match",
    "eval:spelling:dry": "bun scripts/eval-post-process.ts --cases test-data/spelling-corpus/cases.json --dry-run",
    "eval:spelling:models": "bun scripts/run-spelling-model-eval.ts",
    "eval:llm:pending": "bun scripts/run-pending-llm-benchmark-batch.ts",
    "eval:spelling:stt:generate": "bun scripts/generate-stt-spelling-audio.ts",
    "eval:spelling:stt": "bun scripts/run-stt-spelling-model-eval.ts",
    "eval:realworld:stt": "bun scripts/run-stt-spelling-model-eval.ts --manifest test-data/audio-regression/manifest.json --skip-generate --no-categories --output-dir output/stt-realworld-model-eval --summary-name stt-realworld-summary --suite-title \"STT Real-World Model Evaluation Matrix\" --description \"OpenSLR Mini LibriSpeech dev-clean-2 WAV clips from test-data/audio-regression. Post-processing is disabled, so this measures raw transcription only.\"",
    "models:stt:download-all": "bun scripts/download-all-stt-models.ts",
    "models:validate-public": "bun scripts/validate-public-model-catalog.ts",
    "models:validate-licenses": "bun scripts/validate-model-license-compliance.ts",
    "audit:distribution": "bun scripts/audit-distribution-readiness.ts",
    "audit:app-store": "bun scripts/audit-app-store-readiness.ts",
    "check:translations": "bun scripts/check-translations.ts",
    "audit:translations": "bun scripts/audit-untranslated-locales.ts",
    "postinstall": "bun scripts/check-nix-deps.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.0",
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001792",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "i18next": "^25.10.10",
    "immer": "^11.1.8",
    "lucide-react": "^1.14.0",
    "postcss": "^8.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-select": "^5.10.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^9.39.4",
    "eslint-plugin-i18next": "^6.1.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.21",
    "brace-expansion": "1.1.13",
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001790",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "minimatch": "3.1.4",
    "picomatch": "4.0.4",
    "rollup": "4.59.0",
    "yaml": "1.10.3"
  }
}
