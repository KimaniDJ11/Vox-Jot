#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/ask-claude "prompt"
  printf '%s\n' "prompt" | scripts/ask-claude

Runs Claude Code in non-interactive print mode for read-only critique,
alternative designs, and edge-case review. Codex remains responsible for
code edits, validation, and final decisions.

Environment:
  CLAUDE_BIN=/path/to/claude       Override the Claude CLI path.
  ASK_CLAUDE_RUNTIME=/path/to/bin  Run the Claude CLI script through a runtime.
  ASK_CLAUDE_MODEL=sonnet          Optional Claude model/alias; defaults to opus.
  ASK_CLAUDE_TIMEOUT_SECONDS=180   Max runtime before the review is stopped.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -gt 0 ]]; then
  prompt="$*"
else
  if [[ -t 0 ]]; then
    usage >&2
    exit 64
  fi
  prompt="$(cat)"
fi

if [[ -z "${prompt//[[:space:]]/}" ]]; then
  echo "ask-claude: prompt is empty" >&2
  exit 64
fi

claude_bin="${CLAUDE_BIN:-}"
if [[ -z "$claude_bin" ]]; then
  claude_bin="$(command -v claude || true)"
fi

if [[ -n "$claude_bin" ]] && head -n 1 "$claude_bin" 2>/dev/null | grep -q 'claude native binary not installed'; then
  claude_bin=""
fi

if [[ -z "$claude_bin" && -x /opt/homebrew/bin/claude ]]; then
  claude_bin="/opt/homebrew/bin/claude"
fi

if [[ -z "$claude_bin" ]]; then
  echo "ask-claude: Claude CLI not found on PATH; install Claude Code or set CLAUDE_BIN" >&2
  exit 127
fi

claude_args=(
  --print
  --output-format text
  --setting-sources user
  --mcp-config '{"mcpServers":{}}'
  --strict-mcp-config
  --model "${ASK_CLAUDE_MODEL:-opus}"
  --append-system-prompt "Use the deepest practical analysis for the request. Be concise in the final answer, but do not skip edge cases, risks, or alternatives during review."
)

claude_args+=(
  --disallowedTools
  Bash
  Edit
  Write
  MultiEdit
  NotebookEdit
  WebFetch
  WebSearch
)

run_with_timeout() {
  local timeout_seconds="${ASK_CLAUDE_TIMEOUT_SECONDS:-180}"

  if [[ "$timeout_seconds" == "0" ]]; then
    exec "$@"
  fi

  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]]; then
    echo "ask-claude: ASK_CLAUDE_TIMEOUT_SECONDS must be a non-negative integer" >&2
    exit 64
  fi

  perl -e '
    use strict;
    use warnings;

    my $timeout = shift @ARGV;
    my $pid = fork();
    die "ask-claude: failed to fork: $!\n" unless defined $pid;

    if ($pid == 0) {
      exec @ARGV or die "ask-claude: failed to exec $ARGV[0]: $!\n";
    }

    local $SIG{ALRM} = sub {
      kill "TERM", $pid;
      sleep 2;
      kill "KILL", $pid;
      print STDERR "ask-claude: timed out after ${timeout}s\n";
      exit 124;
    };

    alarm $timeout;
    waitpid($pid, 0);
    my $status = $?;
    alarm 0;

    if ($status == -1) {
      print STDERR "ask-claude: waitpid failed: $!\n";
      exit 70;
    }
    if ($status & 127) {
      exit(128 + ($status & 127));
    }
    exit($status >> 8);
  ' "$timeout_seconds" "$@"
}

run_claude() {
  if [[ -n "${ASK_CLAUDE_RUNTIME:-}" ]]; then
    run_with_timeout "$ASK_CLAUDE_RUNTIME" "$claude_bin" "${claude_args[@]}" -- "$prompt"
    exit $?
  fi

  node_major=""
  if command -v node >/dev/null 2>&1; then
    node_version="$(node --version 2>/dev/null || true)"
    node_major="${node_version#v}"
    node_major="${node_major%%.*}"
  fi

  if [[ "$node_major" =~ ^[0-9]+$ ]] && (( node_major >= 25 )); then
    if command -v bun >/dev/null 2>&1; then
      run_with_timeout bun "$claude_bin" "${claude_args[@]}" -- "$prompt"
      exit $?
    fi

    echo "ask-claude: Claude CLI is installed, but Node $node_major is too new for this Claude build." >&2
    echo "ask-claude: Install a compatible Node runtime or install Bun, then retry." >&2
    exit 70
  fi

  run_with_timeout "$claude_bin" "${claude_args[@]}" -- "$prompt"
}

run_claude
