{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox Jot",
  "version": "1.0.2",
  "identifier": "com.iriedinamik.voxjot",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://huggingface.co https://*.hf.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://huggingface.co/IrieDinamik/vox-jot-releases/resolve/main/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NUVDQUUxMEIwRDdBOEMKUldTTWVnMEw0Y3BlMXlmSzVvcWwxR2VqaFc0VmZpOEs4Tld5Ujk0MUhQSG5kZUN2aW5RdjdBY1kK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "Copyright (c) 2026 Irie Dinamik",
    "targets": "all",
    "resources": [
      "resources/**/*",
      "../ocr-runtime/README.md",
      "../ocr-runtime/pyproject.toml",
      "../ocr-runtime/ocr_runtime/**/*"
    ],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/vox-jot-dmg-background.png",
        "windowSize": {
          "width": 760,
          "height": 520
        },
        "appPosition": {
          "x": 217,
          "y": 348
        },
        "applicationFolderPosition": {
          "x": 580,
          "y": 348
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Kimani James (NS5M2UJLKP)",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      }
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net/ -a CJ-Signing -c cjpais-dev -d \"Vox Jot\" %1",
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    }
  }
}
